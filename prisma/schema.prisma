// AuthorLoft - Multi-tenant SaaS Author Platform
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── System Config (singleton) ────────────────────────────────────────────────

model SystemConfig {
  id                      String   @id @default("main")
  maintenanceMode         Boolean  @default(false)
  maintenanceMessage      String   @default("")
  betaMode                Boolean  @default(false)
  betaMessage             String   @default("")
  newSignupNotifications  Boolean  @default(true)
  signupNotificationEmail String   @default("")
  defaultAiUsageCap       Int      @default(20)
  welcomeEmailSubject     String?
  welcomeEmailBody        String?
  updatedAt               DateTime @updatedAt
}

// ─── Beta Invite Codes ────────────────────────────────────────────────────────

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  label     String    @default("")
  maxUses   Int       @default(1)
  usesCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// ─── Plans & Billing ─────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  STANDARD
  PREMIUM
}

model Plan {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  tier                 PlanTier  @unique
  description          String?
  monthlyPriceCents    Int       @default(0)
  annualPriceCents     Int       @default(0)
  stripePriceId        String?
  stripePriceIdMonthly String?
  stripePriceIdAnnual  String?
  maxBooks             Int?
  maxPosts             Int?
  maxStorageMb         Int?
  customDomain         Boolean   @default(false)
  salesEnabled         Boolean   @default(false)
  flipBooksLimit       Int       @default(0)    // 0 = none, -1 = unlimited, n = max count
  audioEnabled         Boolean   @default(false)
  analyticsEnabled     Boolean   @default(false)
  newsletter           Boolean   @default(false)
  mediaKitEnabled      Boolean   @default(false)
  bookstoreListingEnabled Boolean @default(true)
  preOrdersEnabled     Boolean   @default(true)
  featuresJson         String?
  badgeColor           String    @default("gray")
  featuredLabel        String?
  sortOrder            Int       @default(0)
  isActive             Boolean   @default(true)
  isDefault            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  authors              Author[]
  trialAuthors         Author[]           @relation("AuthorTrialPlan")
  subscriptions        AuthorSubscription[]
}

// ─── Authors (Tenants) ────────────────────────────────────────────────────────

model Author {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String?
  name                 String
  displayName          String?
  slug                 String         @unique
  customDomain         String?        @unique
  bio                  String?        @db.Text
  shortBio             String?
  profileImageUrl      String?
  logoUrl              String?
  heroImageUrl         String?
  heroLayout           String         @default("author-right")
  heroTitle            String?
  heroSubtitle         String?
  accentColor          String         @default("#7B2D2D")  // legacy — no longer drives UI; kept for data safety
  customAccentColor    String?        // PREMIUM custom accent override; null = use theme accent. Takes precedence over theme when Premium.
  customSecondaryColor String?        // PREMIUM custom secondary/highlight colour; null = no override (hero falls back to accent-only styling).
  baseTheme            String         @default("classic-literary") // last base theme before a genre palette was applied; used on plan downgrade
  tagline              String?
  linkedinUrl          String?
  youtubeUrl           String?
  facebookUrl          String?
  twitterUrl           String?
  instagramUrl         String?
  contactEmail         String?
  contactResponseTime  String?
  contactOpenTo        String?
  adminTheme           String         @default("light")  // admin UI preference: "light" | "dark"
  aiApiKey             String?
  aiUsageCount         Int       @default(0)
  aiUsageCap           Int       @default(20)
  aiUsageResetAt       DateTime?
  aboutStats           Json?
  credentials          Json?
  legalNotice          String?        @db.Text  // author's own legal/disclaimer notice
  legalNoticeUpdatedAt DateTime?               // stamped when author saves a new version
  showHeroBanner       Boolean        @default(true)
  heroFeaturedBookId   String?
  heroFeaturedBook     Book?          @relation("HeroFeaturedBook", fields: [heroFeaturedBookId], references: [id])
  homeTemplate         String         @default("classic")
  booksLayout          String         @default("list")
  siteTheme            String         @default("classic-literary")
  navShowAbout         Boolean        @default(true)
  navShowBooks         Boolean        @default(true)
  navShowSpecials      Boolean        @default(true)
  navShowFlipBooks     Boolean        @default(true)
  navShowBlog          Boolean        @default(false)
  navShowContact       Boolean        @default(true)
  navShowMediaKit      Boolean        @default(false)
  pressTitle           String?
  pressBio             String?        @db.Text
  pressContact         String?
  pressOutlets         String[]
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  assignedCouponId          String?   // Stripe coupon ID assigned by super-admin, auto-applied at next checkout
  stripeConnectAccountId    String?   // Stripe Express connected account ID (acct_xxx)
  stripeConnectOnboarded    Boolean   @default(false) // true once onboarding is complete
  planId               String?
  plan                 Plan?          @relation(fields: [planId], references: [id])
  isActive             Boolean        @default(true)
  isSuperAdmin         Boolean        @default(false)
  emailVerified        DateTime?
  emailVerifyToken     String?        @unique
  emailVerifyExpiry    DateTime?
  passwordResetToken   String?        @unique
  passwordResetExpiry  DateTime?
  emailProvider        String?        // "KIT" | "MAILCHIMP" | "ACTIVECAMPAIGN"
  emailProviderKey     String?        // API key for the connected email service
  emailProviderExtra   String?        // Provider-specific extra: Mailchimp audience ID or ActiveCampaign account URL
  platformEmailOptOut  Boolean   @default(false)
  platformEmailsToken  String    @unique @default(cuid())
  termsAcceptedAt         DateTime?      // null = never accepted; non-null = timestamp of acceptance
  onboardingCompletedAt        DateTime?  // set when first book is created; null = never completed onboarding
  onboardingEarlyReminderSentAt DateTime? // set when the day-3 nudge email is sent
  onboardingReminderSentAt     DateTime?  // set when the day-7 nudge email is sent
  hideNextStepsChecklist       Boolean   @default(false) // paid-plan authors can dismiss the Next Steps card
  showInShowcase               Boolean   @default(false) // author has opted in to being shown on the marketing page showcase
  showcaseStyle                String    @default("photo") // "photo" | "book" | "text" — controls what the showcase card displays
  trialPlanId          String?        // plan ID for admin-assigned free trial
  trialPlan            Plan?          @relation("AuthorTrialPlan", fields: [trialPlanId], references: [id])
  trialStartsAt        DateTime?      // when the trial began
  trialEndsAt          DateTime?      // when the trial expires; null = not on a trial
  trialExpiryReminderSentAt DateTime? // set when the 7-day warning email is sent
  lastLoginAt          DateTime?      // null = never logged in; non-null = timestamp of last successful login
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  books                Book[]
  flipBooks            FlipBook[]
  genres               Genre[]
  series               Series[]
  subscribers          Subscriber[]
  campaigns            Campaign[]
  orders               Order[]
  sessions             Session[]
  accounts             Account[]
  specials             Special[]
  pages                AuthorPage[]
  posts                Post[]
  contactMessages      ContactMessage[]
  subscription         AuthorSubscription?
  discountCodes        DiscountCode[]
  impersonationsAsSuperAdmin ImpersonationLog[] @relation("ImpersonationAsSuperAdmin")
  impersonationsAsTarget     ImpersonationLog[] @relation("ImpersonationAsTarget")
  preOrderSignups      PreOrderSignup[]
  magnetLeads          BookMagnetLead[]

  @@index([slug])
  @@index([customDomain])
}

// ─── SEO Config ───────────────────────────────────────────────────────────────

model SeoConfig {
  id         String   @id // "home" | "blog" | "features" | "pricing" | "contact" | "resources"
  ogImageUrl String?
  updatedAt  DateTime @updatedAt
}

// ─── Author Subscription ──────────────────────────────────────────────────────

model AuthorSubscription {
  id                 String   @id @default(cuid())
  authorId           String   @unique
  author             Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan     @relation(fields: [planId], references: [id])
  status             String   @default("active")
  billingInterval    String   @default("monthly")
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  renewalReminderSentAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ─── Auth (NextAuth) ──────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  authorId     String
  expires      DateTime
  author       Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  authorId          String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  author            Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Genre / Category ────────────────────────────────────────────────────────

model Genre {
  id          String      @id @default(cuid())
  authorId    String
  name        String
  slug        String
  description String?
  parentId    String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  author      Author      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Genre?      @relation("GenreChildren", fields: [parentId], references: [id])
  children    Genre[]     @relation("GenreChildren")
  books       BookGenre[]

  @@unique([authorId, slug, parentId])
  @@index([authorId])
}

// ─── Series ───────────────────────────────────────────────────────────────────

model Series {
  id          String   @id @default(cuid())
  authorId    String
  name        String
  slug        String
  description String?  @db.Text
  coverUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  books       Book[]

  @@unique([authorId, slug])
  @@index([authorId])
}

// ─── Books ────────────────────────────────────────────────────────────────────

model Book {
  id                  String               @id @default(cuid())
  authorId            String
  seriesId            String?
  title               String
  slug                String
  subtitle            String?
  description         String?              @db.Text
  shortDescription    String?
  sampleContent       String?              @db.Text
  coverImageUrl       String?
  publishedAt         DateTime?
  isbn                String?
  pageCount           Int?
  language            String               @default("en")
  priceCents          Int                  @default(0)
  stripePriceId       String?
  fileUrl             String?
  flipBookUrl         String?
  externalBuyUrl      String?
  availableFormats    String[]
  caption             String?
  releaseDate         DateTime?
  isFeatured          Boolean              @default(false)
  isPublished         Boolean              @default(true)
  directSalesEnabled  Boolean              @default(false)
  listInBookstore     Boolean              @default(false)  // author opt-in to the public AuthorLoft Bookstore (STANDARD+)
  isPreOrder          Boolean              @default(false)  // shows "Coming Soon" + wishlist instead of buy buttons
  preOrderDate        DateTime?            // expected release/launch date for pre-order books
  launchDate          DateTime?            // countdown target date for Book Launch Mode
  showCountdown       Boolean              @default(false)  // show public countdown timer on book page
  affiliateEnabled    Boolean              @default(false)  // author opt-in to the referral/affiliate program for this book
  affiliateCommissionPercent Int           @default(10)     // % of sale price credited to a referrer
  sortOrder           Int                  @default(0)
  views               Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  author              Author               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series              Series?              @relation(fields: [seriesId], references: [id])
  genres              BookGenre[]
  orderItems          OrderItem[]
  retailerLinks       BookRetailerLink[]
  directSaleItems     BookDirectSaleItem[]
  audioTracks         BookAudioTrack[]
  previewMedia        BookPreviewMedia[]
  reviews             BookReview[]
  bookFeedback        BookFeedback[]
  discountCodeBooks   DiscountCodeBook[]
  heroFeaturedAuthors Author[]     @relation("HeroFeaturedBook")
  arcCopies           ArcCopy[]
  preOrderSignups     PreOrderSignup[]
  affiliateReferrals  AffiliateReferral[]
  magnetLeads         BookMagnetLead[]

  @@unique([authorId, slug])
  @@index([authorId])
  @@index([seriesId])
}

// ─── Direct Sale Items ────────────────────────────────────────────────────────

enum DirectSaleFormat {
  EBOOK
  AUDIO
  FLIPBOOK
  PRINT
}

model BookDirectSaleItem {
  id             String           @id @default(cuid())
  bookId         String
  book           Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  format         DirectSaleFormat
  label          String
  description    String?
  priceCents     Int              @default(0)
  isActive       Boolean          @default(true)
  isReaderMagnet Boolean          @default(false)
  sortOrder      Int              @default(0)
  fileUrl        String?          // Supabase storage URL (for display / reference)
  fileKey        String?          // Supabase storage path (e.g. "authorId/book-files/...") — used for deletion & signing
  fileName       String?          // Original filename shown in admin UI
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItems     OrderItem[]
  magnetLeads    BookMagnetLead[]

  @@index([bookId])
}

// ─── Book Audio Tracks ────────────────────────────────────────────────────────

model BookAudioTrack {
  id              String   @id @default(cuid())
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title           String                        // e.g. "Chapter 1 Excerpt", "Author Narration"
  description     String?
  url             String                        // Supabase public URL or external URL
  fileKey         String?                       // Supabase storage path — for deletion
  mimeType        String?                       // e.g. "audio/mpeg"
  durationSeconds Int?                          // optional, filled manually or from metadata
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bookId])
}

// ─── Book Preview Media ───────────────────────────────────────────────────────

enum PreviewMediaType {
  IMAGE
  VIDEO
  AUDIO
}

model BookPreviewMedia {
  id               String           @id @default(cuid())
  bookId           String
  book             Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  position         Int              // 1, 2, or 3
  mediaType        PreviewMediaType @default(IMAGE)
  fileUrl          String           // main media file (image/MP4/MP3)
  fileKey          String?          // Supabase storage path for deletion
  thumbnailUrl     String?          // poster image for VIDEO/AUDIO slots
  thumbnailFileKey String?          // Supabase path for poster deletion
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([bookId, position])
  @@index([bookId])
}

// ─── Book Reviews ────────────────────────────────────────────────────────────

model BookReview {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  quote        String   @db.Text
  reviewerName String
  source       String?
  rating       Int?                              // 1–5 stars, optional
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bookId])
}

// ─── Book Feedback (Reader-Submitted) ────────────────────────────────────────

enum BookFeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

model BookFeedback {
  id            String             @id @default(cuid())
  bookId        String
  book          Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reviewerName  String
  reviewerEmail String
  rating        Int                // 1–5 required
  comment       String?            @db.Text
  status        BookFeedbackStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([bookId])
  @@index([status])
}

// ─── Flip Books ───────────────────────────────────────────────────────────────

model FlipBook {
  id              String   @id @default(cuid())
  authorId        String
  author          Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  subtitle        String?
  description     String?  @db.Text
  slug            String
  flipBookUrl     String?
  coverImageUrl   String?
  coverImageKey   String?                       // Supabase storage path — for deletion
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([authorId, slug])
  @@index([authorId])
}

// ─── Retailer Buy Links ───────────────────────────────────────────────────────

model BookRetailerLink {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  retailer  String
  label     String
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
}

model BookGenre {
  bookId  String
  genreId String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
}

// ─── Specials / Promotions ────────────────────────────────────────────────────

model Special {
  id             String        @id @default(cuid())
  authorId       String
  title          String
  description    String?       @db.Text
  imageUrl       String?
  ctaLabel       String?
  ctaUrl         String?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean       @default(true)
  discountCodeId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  author         Author        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([discountCodeId])
}

// ─── Custom Pages ─────────────────────────────────────────────────────────────

model AuthorPage {
  id        String   @id @default(cuid())
  authorId  String
  slug      String
  title     String
  navTitle  String?
  content   String?  @db.Text
  isVisible Boolean  @default(true)
  showInNav Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, slug])
}

// ─── Blog / News Posts ────────────────────────────────────────────────────────

model Post {
  id              String    @id @default(cuid())
  authorId        String
  title           String
  slug            String
  excerpt         String?   @db.Text
  content         String?   @db.Text
  coverImageUrl   String?
  publishedAt     DateTime?
  isPublished     Boolean   @default(false)
  views           Int       @default(0)
  // SEO fields
  seoTitle        String?                    // overrides title in <title> tag if set
  metaDescription String?   @db.Text        // overrides excerpt in meta description if set
  focusKeyword    String?                    // author's target keyword — guidance only
  // Downloadable resource
  attachmentUrl   String?                    // external link or uploaded file URL
  attachmentLabel String?                    // e.g. "Download Free Chapter"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  author          Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, slug])
  @@index([authorId])
}

// ─── Newsletter Subscribers ───────────────────────────────────────────────────

model Subscriber {
  id               String   @id @default(cuid())
  authorId         String
  name             String?
  email            String
  categoryPrefs    String[]
  isConfirmed      Boolean  @default(false)
  confirmToken     String?  @unique
  unsubscribeToken String   @default(cuid())
  subscribedAt     DateTime @default(now())
  author           Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, email])
  @@index([authorId])
}

// ─── Newsletter Campaigns ─────────────────────────────────────────────────────

model Campaign {
  id           String   @id @default(cuid())
  authorId     String
  subject      String
  sentAt       DateTime @default(now())
  totalSent    Int
  totalFailed  Int
  totalTargeted Int
  author       Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

model PlatformBroadcast {
  id             String   @id @default(cuid())
  subject        String
  body           String
  audienceFilter String   @default("ALL")
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())
  sentBy         String
  createdAt      DateTime @default(now())
}

model BroadcastTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Orders & Sales ───────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

model Order {
  id                    String        @id @default(cuid())
  authorId              String
  customerEmail         String
  customerName          String?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  totalCents            Int
  discountCents         Int           @default(0)
  discountCodeId        String?
  status                OrderStatus   @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  author                Author        @relation(fields: [authorId], references: [id])
  discountCode          DiscountCode? @relation(fields: [discountCodeId], references: [id])
  items                 OrderItem[]

  @@index([authorId])
  @@index([customerEmail])
}

// ─── Discount Codes ───────────────────────────────────────────────────────────

model DiscountCodeBook {
  discountCodeId String
  bookId         String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  book           Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([discountCodeId, bookId])
  @@index([bookId])
}

model DiscountCode {
  id              String             @id @default(cuid())
  authorId        String
  author          Author             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  code            String             // stored uppercase, e.g. "LAUNCH20"
  description     String?            // internal note for the author
  type            String             // "PERCENT" | "FIXED"
  value           Int                // percent 1-100, or fixed cents (e.g. 500 = $5.00)
  maxUses         Int?               // null = unlimited
  usesCount       Int                @default(0)
  expiresAt       DateTime?          // null = no expiry
  isActive        Boolean            @default(true)
  showAsSalePrice Boolean            @default(false) // when true, show discounted price publicly on book pages
  books           DiscountCodeBook[]
  specials        Special[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  orders          Order[]

  @@unique([authorId, code])
  @@index([authorId])
}

model OrderItem {
  id             String              @id @default(cuid())
  orderId        String
  bookId         String
  saleItemId     String?             // links to BookDirectSaleItem — which format was purchased
  priceCents     Int
  fileKey        String?             // Supabase storage path — copied at purchase time for secure delivery
  downloadToken  String              @unique @default(cuid())
  downloadCount  Int                 @default(0)
  maxDownloads   Int                 @default(5)
  downloadExpiry DateTime?
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book           Book                @relation(fields: [bookId], references: [id])
  saleItem       BookDirectSaleItem? @relation(fields: [saleItemId], references: [id])

  @@index([orderId])
  @@index([downloadToken])
}

// ─── Contact Messages ─────────────────────────────────────────────────────────

model ContactMessage {
  id          String   @id @default(cuid())
  authorId    String
  senderName  String
  senderEmail String
  website     String?
  subject     String?
  message     String   @db.Text
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  author      Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@index([authorId, isRead])
}

// ─── Platform-level access requests (beta invite requests) ───────────────────

model AccessRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  usageType String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}

// ─── Support Emails ───────────────────────────────────────────────────────────

model SupportEmail {
  id          String   @id @default(cuid())
  label       String
  email       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Homepage FAQs ────────────────────────────────────────────────────────────

model HomepageFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?  // Category slug (type = "faq"); null/empty → "General"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Shared Categories (blog / resource / faq) ────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  type        String   // "blog" | "resource" | "faq"
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, slug])
  @@index([type, isActive])
}

// ─── Downloadable Resources (gated by email) ──────────────────────────────────

model ResourceDownload {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String?
  body          String?   @db.Text // optional RTE detail content
  category      String    // Category slug, type = "resource"
  fileUrl       String    // Drive/Supabase/direct — never exposed raw to the client
  coverImageUrl String?
  requiresEmail Boolean   @default(true)
  downloadCount Int       @default(0)
  isPublished   Boolean   @default(true)
  displayOrder  Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, category])
}

model DownloadLead {
  id         String   @id @default(cuid())
  email      String
  resourceId String?
  source     String?  // "resource" | "blog"
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ─── Testimonials ─────────────────────────────────────────────────────────────

model Testimonial {
  id           String   @id @default(cuid())
  authorName   String
  authorRole   String?
  quote        String   @db.Text
  rating       Int?
  image        String?
  isActive     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Platform Settings (singleton) ───────────────────────────────────────────

model PlatformSettings {
  id                    String    @id @default("singleton")
  privacyContent        String?   @db.Text
  privacyUpdatedAt      DateTime?
  termsContent          String?   @db.Text
  termsUpdatedAt        DateTime?
  contactEmail          String?
  marketingHeroImageUrl String?
  socialLinks           Json      @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ─── Plan Feature Gates (singleton) ──────────────────────────────────────────
// Stores which minimum plan tier is required to access each admin feature.
// Managed via Super Admin → Feature Gates UI.

model PlanFeatureConfig {
  id        String   @id @default("singleton")
  gates     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model StripeEvent {
  id          String   @id  // Stripe event ID (evt_xxx) — unique by design
  processedAt DateTime @default(now())
}

// ─── Help Centre ──────────────────────────────────────────────────────────────

model HelpTopic {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  icon        String?        // lucide icon name e.g. "BookOpen"
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  subtopics   HelpSubtopic[]
  articles    HelpArticle[]
}

model HelpSubtopic {
  id        String        @id @default(cuid())
  topicId   String
  title     String
  slug      String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  topic     HelpTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  articles  HelpArticle[]

  @@unique([topicId, slug])
  @@index([topicId])
}

model HelpArticle {
  id          String        @id @default(cuid())
  topicId     String
  subtopicId  String?
  question    String        @db.Text  // rich HTML
  answer      String        @db.Text  // rich HTML
  sortOrder   Int           @default(0)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  topic       HelpTopic     @relation(fields: [topicId], references: [id])
  subtopic    HelpSubtopic? @relation(fields: [subtopicId], references: [id])

  @@index([topicId])
  @@index([subtopicId])
}

model HelpTooltip {
  id           String   @id @default(cuid())
  tooltipKey   String   @unique
  title        String
  content      String
  learnMoreUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ImpersonationLog {
  id            String   @id @default(cuid())
  superAdminId  String
  targetAuthorId String
  action        String   // "start" | "end"
  createdAt     DateTime @default(now())

  superAdmin    Author   @relation("ImpersonationAsSuperAdmin", fields: [superAdminId],   references: [id])
  targetAuthor  Author   @relation("ImpersonationAsTarget",     fields: [targetAuthorId], references: [id])
}

// ─── ARC (Advance Reader Copies) ─────────────────────────────────────────────

enum ArcReaderSource {
  INVITED
  APPLIED
}

enum ArcReaderStatus {
  PENDING
  INVITED
  DOWNLOADED
  REVIEWED
  DECLINED
}

enum ArcReviewPlatform {
  AMAZON
  GOODREADS
  BOOKBUB
  BLOG
  OTHER
}

model ArcCopy {
  id          String      @id @default(cuid())
  bookId      String
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  disclaimer  String?     @db.Text
  isActive    Boolean     @default(true)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  files       ArcFile[]
  readers     ArcReader[]

  @@index([bookId])
}

model ArcFile {
  id            String      @id @default(cuid())
  arcCopyId     String
  arcCopy       ArcCopy     @relation(fields: [arcCopyId], references: [id], onDelete: Cascade)
  format        String      // "PDF", "EPUB", "MOBI", etc.
  fileUrl       String
  fileKey       String
  fileName      String
  fileSizeBytes Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  downloads     ArcReaderDownload[]

  @@index([arcCopyId])
  @@unique([arcCopyId, format])
}

model ArcReader {
  id                       String             @id @default(cuid())
  arcCopyId                String
  arcCopy                  ArcCopy            @relation(fields: [arcCopyId], references: [id], onDelete: Cascade)
  email                    String
  name                     String
  source                   ArcReaderSource    @default(INVITED)
  status                   ArcReaderStatus    @default(INVITED)
  token                    String             @unique
  tokenExpiresAt           DateTime?
  reviewPlatform           ArcReviewPlatform?
  reviewUrl                String?
  notes                    String?            @db.Text
  disclaimerAcknowledgedAt DateTime?
  invitedAt                DateTime?
  downloadedAt             DateTime?
  reviewedAt               DateTime?
  reminderSentAt           DateTime?
  createdAt                DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  downloads                ArcReaderDownload[]

  @@index([arcCopyId])
  @@index([token])
  @@index([email])
}

model ArcReaderDownload {
  id            String      @id @default(cuid())
  readerId      String
  reader        ArcReader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  fileId        String
  file          ArcFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  downloadedAt  DateTime    @default(now())

  @@index([readerId])
  @@index([fileId])
  @@unique([readerId, fileId])
}

// ─── Social Media ─────────────────────────────────────────────────────────────

model SocialPlatformToken {
  id             String    @id @default(cuid())
  platform       String    // "LINKEDIN" | "FACEBOOK" | "INSTAGRAM"
  accessToken    String    @db.Text   // AES-256-GCM encrypted
  accountId      String               // page ID / org ID / IG account ID
  accountName    String               // human-readable name for UI
  tokenExpiresAt DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([platform])
}

model SocialPost {
  id          String            @id @default(cuid())
  caption     String            @db.Text
  mediaUrl    String?                      // Supabase public URL
  mediaType   String?                      // "IMAGE" | null
  platforms   String[]                     // ["LINKEDIN","FACEBOOK","INSTAGRAM"]
  status      String            @default("DRAFT") // DRAFT|SCHEDULED|PUBLISHING|PUBLISHED|PARTIAL|FAILED
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  results     SocialPostResult[]

  @@index([status, scheduledAt])
}

model SocialPostResult {
  id             String     @id @default(cuid())
  postId         String
  post           SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform       String     // "LINKEDIN" | "FACEBOOK" | "INSTAGRAM"
  status         String     // "PENDING" | "PUBLISHED" | "FAILED"
  platformPostId String?    // ID returned by the platform on success
  error          String?    @db.Text
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())

  @@index([postId])
}

// ─── Platform Blog Posts ──────────────────────────────────────────────────────

model PlatformPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    @default("") @db.Text
  content         String    @default("") @db.Text
  coverImageUrl   String?
  category        String    @default("")
  authorName      String    @default("AuthorLoft Team")
  readTimeMinutes Int       @default(5)
  displayOrder    Int       @default(0)
  isNews          Boolean   @default(false)   // true = AuthorLoft News (/news); false = blog article (/blog)
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  // SEO fields
  focusKeyword    String?                    // target keyword — editorial guidance
  seoTitle        String?                    // overrides title in <title> tag if set
  metaDescription String?   @db.Text        // overrides excerpt in meta description if set
  // Downloadable resource
  attachmentUrl   String?                    // external link or uploaded file URL
  attachmentLabel String?                    // e.g. "Download Free Chapter"
  // News email — set when this News post is emailed to platform subscribers (guards against double-send)
  newsEmailedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([displayOrder])
  @@index([isNews, isPublished, publishedAt])
}

// ─── Platform Newsletter Subscribers (public AuthorLoft News list) ─────────────
// Platform-scoped (no authorId). Captured from the public News page / footer /
// home subscribe forms. Sending newsletters is a later phase; this just builds
// the audience. Mirrors the GDPR token pattern of the author-scoped Subscriber.

model PlatformSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  isConfirmed      Boolean  @default(false)
  confirmToken     String?  @unique
  unsubscribeToken String   @default(cuid())
  source           String?  // where they signed up: "news" | "footer" | "home"
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ─── Pre-orders / Coming Soon ─────────────────────────────────────────────────
// Captures reader emails for books marked isPreOrder so the author can notify
// them on launch day. One signup per (book, email).

model PreOrderSignup {
  id         String    @id @default(cuid())
  bookId     String
  authorId   String
  email      String
  name       String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author     Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([bookId, email])
  @@index([bookId])
  @@index([authorId])
}

// ─── Affiliate / Referral Program ─────────────────────────────────────────────
// Per-book referral codes an author generates for promoters/readers. Tracks
// click-throughs (via ?ref=CODE) and resulting sales/earnings for revenue share.

model AffiliateReferral {
  id            String   @id @default(cuid())
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  refCode       String
  label         String?
  clicks        Int      @default(0)
  saleCount     Int      @default(0)
  earningsCents Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([bookId, refCode])
  @@index([bookId])
}

// ─── Platform Resources (curated author tool/community directory) ─────────────

model PlatformResource {
  id             String   @id @default(cuid())
  name           String
  category       String   @default("")
  description    String   @default("") @db.Text
  websiteUrl     String
  logoUrl        String?                    // public image URL for logo
  initials       String   @default("")      // 2-4 char fallback when no logo
  avatarColor    String   @default("#1B2B47") // hex bg for initials avatar
  isPartner      Boolean  @default(false)   // confirmed cross-promotion partner
  isActive       Boolean  @default(true)    // hide without deleting
  showOnHomepage Boolean  @default(false)   // show in homepage trusted resources strip
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// ─── Reader Magnet Leads ──────────────────────────────────────────────────────

model BookMagnetLead {
  id             String             @id @default(cuid())
  bookId         String
  saleItemId     String
  authorId       String
  email          String
  name           String?
  downloadToken  String             @unique @default(cuid())
  downloadCount  Int                @default(0)
  maxDownloads   Int                @default(3)
  downloadExpiry DateTime?
  createdAt      DateTime           @default(now())

  book     Book               @relation(fields: [bookId],     references: [id], onDelete: Cascade)
  saleItem BookDirectSaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  author   Author             @relation(fields: [authorId],   references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([bookId])
  @@index([downloadToken])
}